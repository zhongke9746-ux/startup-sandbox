{
  "meta": {
    "pack_id": "mechanisms",
    "name": "通用冲击机理库",
    "version": "0.1.2",
    "updated_at": "2026-11-16",
    "changelog": [
      "0.1.0 | 2026-11-16 | 初版 18 条机理，四族",
      "0.1.1 | 2026-11-16 | 增补 time_profiles.recover + known_gaps（咖啡店演算暴露的 4 个缺口）",
      "0.1.2 | 2026-11-16 | 跨行业校验（咖啡/健身/中餐）新增 GAP-05~13；补 baseline_required_fields"
    ]
  },
  "slots": {
    "fixed_cost": {
      "desc": "固定运营成本",
      "unit": "CNY/month"
    },
    "unit_cost": {
      "desc": "单位变动成本",
      "unit": "CNY/unit"
    },
    "variable_cost": {
      "desc": "随量变化的费用（渠道费/佣金）",
      "unit": "CNY"
    },
    "volume": {
      "desc": "成交/活跃量",
      "unit": "count"
    },
    "price": {
      "desc": "单价",
      "unit": "CNY"
    },
    "churn": {
      "desc": "流失率或复购倒数",
      "unit": "percent"
    },
    "capacity": {
      "desc": "可交付能力",
      "unit": "unit/month"
    },
    "revenue": {
      "desc": "收入",
      "unit": "CNY/month"
    },
    "cash": {
      "desc": "现金",
      "unit": "CNY"
    },
    "valuation": {
      "desc": "估值/融资能力",
      "unit": "index"
    }
  },
  "formula": {
    "multiplicative": "value_t = value_base × (1 ± delta × decay(t))",
    "additive": "value_t = value_base ± (k_abs × exposure × signal_intensity)"
  },
  "time_profiles": {
    "step": "当月全额，永久生效，decay = 1",
    "ramp": "N 个月内线性到位，decay = min(1, t/N)",
    "pulse": "一次性后指数衰减，decay = 0.5^(t/τ)，τ 默认 2 个月",
    "recover": "step 事件结束后，按 recover_months 线性恢复到事件前水平（新增，缺省 = 0 即瞬时恢复）"
  },
  "note_recover": "客流/口碑类冲击恢复期通常 1-3 个月；合规类改造不可恢复（已沉没）",
  "signal_intensity_scale": {
    "policy": {
      "0.3": "征求意见稿、行业倡议、无明确罚则",
      "0.6": "正式发布、有明确生效日",
      "0.9": "已实施且伴随专项执法/明确罚则"
    },
    "platform_rule": {
      "0.3": "灰度测试、局部调整",
      "0.6": "全量生效、影响部分功能",
      "0.9": "接口下线/权限收回/费率大幅上调"
    },
    "sentiment": {
      "0.3": "个别投诉、小范围讨论",
      "0.6": "行业媒体报道、集中投诉",
      "0.9": "主流媒体曝光、监管介入"
    },
    "competition": {
      "0.3": "新玩家试水",
      "0.6": "直接竞品明确动作",
      "0.9": "头部大厂战略级投入"
    },
    "capital_macro": {
      "0.3": "个别机构收紧",
      "0.6": "行业融资额同比明显下滑",
      "0.9": "系统性收缩、退出通道关闭"
    }
  },
