  "second_order_rules": [
    {
      "trigger": "delta >= 0.20 且持续 >= 2 个月",
      "effect": "触发管理动作判定：降本 / 提价 / 收缩业务线（由经营 Agent 决策）"
    },
    {
      "trigger": "同一槽位在 3 个月内被 2 条以上机理命中",
      "effect": "叠加而非取最大值，并标记'复合冲击'"
    },
    {
      "trigger": "delta <= 0.03",
      "effect": "记入日志但不结算（视为噪声）"
    }
  ],
  "known_gaps": [
    {
      "id": "GAP-01",
      "severity": "critical",
      "status": "resolved",
      "resolved_by": "_actions.yaml v0.1.0（2026-11-16），18 个动作，已验证可改变结局（期末现金 +13.5 万）",
      "title": "缺动作库（只有冲击，没有经营动作）",
      "detail": "本库描述的全是外部打击；提价/开外卖/裁员/换供应商/推新品等主动动作无对应条目，导致模拟只能被动衰减，无法比较策略",
      "fix": "新增 _actions.yaml，与机理库对称：动作 → 槽位变化 + 代价 + 成功率 + 生效延迟"
    },
    {
      "id": "GAP-02",
      "severity": "critical",
      "title": "增长未建模，却主导结论",
      "detail": "咖啡店演算中，仅改变月增长率（-1% ~ +1.5%），期末现金从 -6.6 万变到 +20.4 万；该参数不在任何基线的计算路径上",
      "fix": "行业包新增 growth_assumption 区间，引擎按蒙特卡洛扫描，输出分布而非单点"
    },
    {
      "id": "GAP-03",
      "severity": "high",
      "title": "单路径而非分布",
      "detail": "事件缺 probability 字段，一条确定性轨迹不能支撑'可行性'判断",
      "fix": "事件加 probability，跑 N 次输出存活率 / 中位数 / 5% 分位"
    },
    {
      "id": "GAP-04",
      "severity": "medium",
      "title": "评分口径不可跨行业",
      "detail": "LTV/CAC 对单店生意无意义，需 scoring_slot_map 做语义映射",
      "fix": "与 slot_map 同构，行业包提供评分口径映射"
    },
    {
      "id": "GAP-05",
      "severity": "critical",
      "status": "resolved",
      "resolved_by": "_actions.yaml v0.2.0：字段更名 one_time_cash_out + 符号断言",
      "title": "动作一次性成本未声明现金流方向",
      "detail": "v0.1 只写 cost.one_time，实现时把'重谈租约的中介费'当成收入加进现金，一次凭空产生 2.5 万。符号错误不会报错，只会让所有重动作看起来都很划算",
      "fix": "更名为 one_time_cash_out，语义固定为流出；引擎对一次性项做减法并在报告单列"
    },
    {
      "id": "GAP-06",
      "severity": "high",
      "status": "resolved",
      "resolved_by": "_actions.yaml v0.2.0：A-COST-02 引入 share_of_fixed",
      "title": "降某项固定成本时未乘该项占比",
      "detail": "A-COST-02 把'降租 12%'打在 fixed_cost 全量上。实际房租只占固定成本 34%~45%，实测高估 2.2~2.9 倍",
      "fix": "所有单项降本动作必须带 share_of_fixed；缺省不得为 1"
    },
    {
      "id": "GAP-07",
      "severity": "high",
      "status": "resolved",
      "resolved_by": "_actions.yaml v0.2.0：A-PRICE-01/02 引入 elasticity_guard",
      "title": "价格动作被当作无条件有效",
      "detail": "自助健身房 price_elasticity=1.10，提价 8% 掉量 8.8%，收入净减，A-PRICE-01 变成负贡献（-3,450）",
      "fix": "e>=1 时拒绝价格类动作，改指向 A-GROW-03（提客单）"
    },
    {
      "id": "GAP-08",
      "severity": "critical",
      "status": "resolved",
      "resolved_by": "_actions.yaml v0.2.0：A-COST-01 引入 key_person_dependency",
      "title": "人力被当作同质资源",
      "detail": "裁员在中餐店等于动厨师长：建模时净现金 -63,161，不建模时误判为 +54,535，漏判 11.8 万的符号差异",
      "fix": "A-COST-01 增加 volume 惩罚项 = cut_ratio × key_person_dependency，持续 6 个月 + 恢复 4 个月"
    },
    {
      "id": "GAP-09",
      "severity": "critical",
      "status": "resolved",
      "resolved_by": "_actions.yaml v0.2.0：A-CAP-01 改为 volume_gated",
      "title": "加产能被假设为自动带来需求",
      "detail": "v0.1 的 effects 直接写 volume×(1+g×0.5)，等于'产能即需求'。三行业月均利用率 64%~69%，扩产全部是大额负贡献（-15.8 万~-26.5 万）",
      "fix": "新增槽位 volume_gated，仅当利用率≥85% 时才转化；面积天花板 capacity_ceiling 同步进入结算"
    },
    {
      "id": "GAP-10",
